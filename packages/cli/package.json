{
  "name": "@fullstack-starter/cli",
  "version": "0.1.0",
  "description": "CLI to scaffold and extend MERN Fullstack Starter Kit projects",
  "type": "module",
  "bin": {
    "fsk": "./bin/cli.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "dev": "node --watch bin/cli.js",
    "start": "node bin/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mern",
    "starter-kit",
    "scaffold",
    "cli",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^13.3.2",
    "ora": "^8.0.1",
    "tar": "^7.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src"
  ],
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.7.0",
    "@types/tar": "^7.0.87",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
