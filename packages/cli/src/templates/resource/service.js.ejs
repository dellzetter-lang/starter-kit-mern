const <%= resource.pascalName %>Model = require('./<%= resource.name %>.model');
const ApiError = require('../../utils/ApiError');
<% if (options.architecture === 'advanced') { %>
const mongoose = require('mongoose');
<% } %>

<% if (options.architecture === 'advanced') { %>
/**
 * <%= resource.pascalName %> Service
 * Domain logic for <%= resource.name %> operations
 */
class <%= resource.pascalName %>Service {
<% } %>

const create<%= resource.pascalName %> = async (payload) => {
  // Sanitize string fields (trim, lowercase email)
  <% resource.fields.forEach(function(field) { %>
    <% if (['email','phone','url','string','text'].includes(field.type)) { %>
  if (payload.<%= field.name %>) {
    <% if (field.type === 'email') { %>
    payload.<%= field.name %> = payload.<%= field.name %>.toLowerCase().trim();
    <% } else if (field.type === 'phone') { %>
    payload.<%= field.name %> = payload.<%= field.name %>.replace(/[^+0-9]/g, '');
    <% } else { %>
    payload.<%= field.name %> = payload.<%= field.name %>.trim();
    <% } %>
  }
    <% } %>
  <% }); %>

  // Auto-generate slug/code from name if not provided
  <% const slugField = resource.fields.find(f => ['slug','code','sku'].includes(f.name)); %>
  <% if (slugField) { %>
  if (!payload.<%= slugField.name %> && payload.name) {
    const slugify = require('slugify');
    payload.<%= slugField.name %> = slugify(payload.name, { lower: true, strict: true });
  }
  <% } %>

  return await <%= resource.pascalName %>Model.create(payload);
};

const getAll<%= resource.pascalName %>s = async (filters = {}) => {
  const query = <%= resource.pascalName %>Model.find({});

  // Apply filter conditions
  <% resource.fields.forEach(function(field) { %>
    <% if (field.type === 'number' || field.type === 'date' || field.type === 'datetime' || field.type === 'range') { %>
  // Range filters: <%= field.name %>Min, <%= field.name %>Max
  if (filters.<%= field.name %>Min) query = query.where('<%= field.name %>').gte(filters.<%= field.name %>Min);
  if (filters.<%= field.name %>Max) query = query.where('<%= field.name %>').lte(filters.<%= field.name %>Max);
    <% } else { %>
  // Equality filter
  if (filters.<%= field.name %>) query = query.where('<%= field.name %>').equals(filters.<%= field.name %>);
    <% } %>
  <% }); %>

  // Pagination
  const page = filters.page || 1;
  const limit = filters.limit || 20;
  const skip = (page - 1) * limit;

  if (filters.sort) {
    const order = filters.order === 'asc' ? 1 : -1;
    query = query.sort({ [filters.sort]: order });
  }

  // Populate relations (if requested)
  <% if (resource.relations && resource.relations.hasMany && resource.relations.hasMany.length > 0) { %>
  if (filters.populate) {
    const populateList = Array.isArray(filters.populate) ? filters.populate : [filters.populate];
    <% resource.relations.hasMany.forEach(function(rel) { %>
    if (populateList.includes('<%= rel.field %>') || populateList.includes('*')) {
      query = query.populate('<%= rel.field %>');
    }
    <% }); %>
  }
  <% } %>

  query = query.skip(skip).limit(limit);
  return await query.exec();
};

const get<%= resource.pascalName %>ById = async (id) => {
  const doc = await <%= resource.pascalName %>Model.findById(id);
  if (!doc) throw new ApiError(404, '<%= resource.name %> not found');
  return doc;
};

const get<%= resource.pascalName %>ByUnique = async (field, value) => {
  return await <%= resource.pascalName %>Model.findOne({ [field]: value });
};

const update<%= resource.pascalName %> = async (id, updates) => {
  // Sanitize
  <% resource.fields.forEach(function(field) { %>
    <% if (['email','phone','url','string','text'].includes(field.type)) { %>
  if (updates.<%= field.name %>) {
    <% if (field.type === 'email') { %>
    updates.<%= field.name %> = updates.<%= field.name %>.toLowerCase().trim();
    <% } else if (field.type === 'phone') { %>
    updates.<%= field.name %> = updates.<%= field.name %>.replace(/[^+0-9]/g, '');
    <% } else { %>
    updates.<%= field.name %> = updates.<%= field.name %>.trim();
    <% } %>
  }
    <% } %>
  <% }); %>

  const doc = await <%= resource.pascalName %>Model.findByIdAndUpdate(
    id, 
    updates, 
    { new: true, runValidators: true }
  );
  if (!doc) throw new ApiError(404, '<%= resource.name %> not found');
  return doc;
};

const delete<%= resource.pascalName %> = async (id) => {
  <% if (resource.features.softDelete) { %>
  const doc = await <%= resource.pascalName %>Model.findByIdAndUpdate(
    id, 
    { deletedAt: new Date() }, 
    { new: true }
  );
  if (!doc) throw new ApiError(404, '<%= resource.name %> not found');
  return doc;
  <% } else { %>
  const doc = await <%= resource.pascalName %>Model.findByIdAndDelete(id);
  if (!doc) throw new ApiError(404, '<%= resource.name %> not found');
  return doc;
  <% } %>
};

<% if (options.architecture === 'advanced') { %>
// ── Advanced: Batch Operations ───────────────────────────────────────────────
const bulkCreate<%= resource.pascalName %>s = async (items) => {
  if (!Array.isArray(items)) throw new ApiError(400, 'Items must be an array');
  return await <%= resource.pascalName %>Model.insertMany(items);
};

const bulkUpdate<%= resource.pascalName %>s = async (updates) => {
  const session = await mongoose.startSession();
  session.startTransaction();
  try {
    for (const update of updates) {
      await <%= resource.pascalName %>Model.findByIdAndUpdate(update.id, update.changes, { session });
    }
    await session.commitTransaction();
    session.endSession();
    return updates.length;
  } catch (err) {
    await session.abortTransaction();
    session.endSession();
    throw err;
  }
};

module.exports = new <%= resource.pascalName %>Service();
<% } else { %>
module.exports = {
  create<%= resource.pascalName %>,
  getAll<%= resource.pascalName %>s,
  get<%= resource.pascalName %>ById,
  get<%= resource.pascalName %>ByUnique,
  update<%= resource.pascalName %>,
  delete<%= resource.pascalName %>,
<% if (options.architecture === 'advanced') { %>
  bulkCreate<%= resource.pascalName %>s,
  bulkUpdate<%= resource.pascalName %>s,
<% } %>
};
<% } %>
